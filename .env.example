# ─── SERVER ONLY (never prefix with NEXT_PUBLIC_) ───
# Groq API — used only in /api/* route handlers
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Firebase Admin — private. Local file path OR JSON string on Vercel.
# Never commit usemeai.json. Never put this in NEXT_PUBLIC_*.
FIREBASE_SERVICE_ACCOUNT_PATH=./usemeai.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── PUBLIC (browser) — Firebase Web SDK only ───
# These are NOT your service-account secret. Firebase designed them to be
# public; protect the project with Auth domains + API key HTTP referrer
# restrictions in Google Cloud Console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=example-69600.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=example-69600
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=example-69600.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Identity (compact account UI) — Authentication → Sign-in method → Google → Web client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Analytics / Firebase Analytics measurement ID (G-XXXXXXXX)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
